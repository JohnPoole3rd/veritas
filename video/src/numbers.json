    {
     "from": 0.1,
     "to": 6.1,
     "text": "In Upper Arlington, Ohio, the least green part of town was 4.1 degrees hotter than the greenest part."
    }
   ]
  },
  {
   "key": "problem",
   "start": 6.1,
   "dur": 8.81,
