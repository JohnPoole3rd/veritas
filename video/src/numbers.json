     "src": "audio/voice_heat_2.wav",
     "at": 12.3
    },
    {
     "src": "audio/voice_heat_3.wav",
     "at": 17.3
    }
   ],
   "captions": [
    {
     "from": 0.1,
     "to": 6.1,
     "text": "The Heat Lab adds two satellite measurements: how green, and how hot."
    },
    {
     "from": 6.1,
     "to": 12.1,
     "text": "Greener squares are cooler, by about 1.7 degrees for every step in green."
    },
    {
     "from": 12.1,
     "to": 17.1,
     "text": "“Plant first” marks hot squares with few trees."
    },
    {
     "from": 17.1,
     "to": 21.48,
     "text": "Search “parking lot”, see the hottest ones, and download the list."
    }
   ]
  },
  {
   "key": "how",
   "start": 59.29,
   "dur": 19.7,
   "voices": [
    {
     "src": "audio/voice_how_0.wav",
