     "at": 4.3
    }
   ],
   "captions": [
    {
     "from": 0.1,
     "to": 4.1,
     "text": "So where should the city plant new trees?"
    },
    {
     "from": 4.1,
     "to": 8.81,
     "text": "Satellites photograph every street every few days. That's too much to look through."
    }
   ]
  },
  {
   "key": "idea",
