     "src": "audio/voice_how_2.wav",
     "at": 12.3
    }
   ],
   "captions": [
    {
     "from": 0.1,
     "to": 6.1,
     "text": "How does it work? One AI turns photos into numbers. Another turns words into numbers."
    },
    {
     "from": 6.1,
     "to": 12.1,
     "text": "We line the two up with one rotation. No training."
    },
    {
     "from": 12.1,
     "to": 19.7,
     "text": "On new photos, the right land type comes first 96% of the time. A random rotation gets 15%."
    }
   ]
  },
  {
