   "captions": [
    {
     "from": 0.1,
     "to": 5.1,
     "text": "The same app adds two satellite measurements: how green, and how hot."
    },
    {
     "from": 5.1,
     "to": 10.1,
     "text": "Greener squares are cooler, by about 1.7 degrees for every step in green."
    },
    {
     "from": 10.1,
     "to": 15.1,
     "text": "“Plant first” marks hot squares with few trees."
    },
    {
     "from": 15.1,
     "to": 17.37,
     "text": "Download the list."
    }
   ]
  },
  {
