   "captions": [
    {
     "from": 0.1,
     "to": 6.41,
     "text": "In Upper Arlington, Ohio, the least green part of town was 4.1 degrees hotter than the greenest part."
    }
   ]
  },
  {
   "key": "problem",
   "start": 6.41,
   "dur": 9.73,
   "voices": [
    {
     "src": "audio/voice_problem_0.wav",
     "at": 0.3
    },
    {
     "src": "audio/voice_problem_1.wav",
     "at": 4.3
    }
   ],
   "captions": [
    {
     "from": 0.1,
     "to": 4.1,
     "text": "So where should the city plant new trees?"
    },
    {
     "from": 4.1,
     "to": 9.73,
     "text": "Satellites take a new picture of every street every few days. That's too much to look through."
    }
   ]
  },
  {
   "key": "idea",
   "start": 16.14,
   "dur": 6.11,
   "voices": [
    {
     "src": "audio/voice_idea_0.wav",
     "at": 0.3
    }
   ],
   "captions": [
    {
     "from": 0.1,
     "to": 6.11,
     "text": "So we built a way to search satellite photos in plain English, without training a new AI."
    }
   ]
  },
  {
   "key": "search",
   "start": 22.25,
   "dur": 15.56,
   "voices": [
    {
     "src": "audio/voice_search_0.wav",
     "at": 0.3
    },
    {
     "src": "audio/voice_search_1.wav",
     "at": 3.8
    },
    {
     "src": "audio/voice_search_2.wav",
     "at": 9.3
    }
   ],
   "captions": [
    {
     "from": 0.1,
     "to": 3.6,
     "text": "Type “river corridor”."
    },
    {
     "from": 3.6,
     "to": 9.1,
     "text": "All 6 top results really are the river. We checked them against our own labels."
    },
    {
     "from": 9.1,
     "to": 15.56,
     "text": "Any words work, like “tall trees near a river”. The number is a match score, not a percent."
    }
   ]
  },
  {
   "key": "heat",
   "start": 37.81,
   "dur": 21.48,
   "voices": [
    {
     "src": "audio/voice_heat_0.wav",
     "at": 0.3
