    {
     "from": 6.1,
     "to": 10.1,
     "text": "We line the two up with one rotation,"
    },
    {
     "from": 10.1,
     "to": 15.42,
     "text": "fitted on one million satellite photos captioned from OpenStreetMap."
    }
   ]
