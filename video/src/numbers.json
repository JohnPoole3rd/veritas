   "dur": 5.17,
   "voices": [
    {
     "src": "audio/voice_idea_0.wav",
     "at": 0.3
    }
   ],
   "captions": [
    {
     "from": 0.1,
     "to": 5.17,
     "text": "So we built a way to search satellite photos of anywhere on Earth, in plain English."
    }
   ]
  },
  {
   "key": "search",
   "start": 20.08,
   "dur": 9.08,
