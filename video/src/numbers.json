   "captions": [
    {
     "from": 0.1,
     "to": 3.6,
     "text": "Pick a place and set a radius."
    },
    {
     "from": 3.6,
     "to": 6.1,
     "text": "Type “parking lots”."
    },
    {
     "from": 6.1,
     "to": 9.08,
     "text": "The best-matching squares light up on the map."
    }
   ]
  },
  {
   "key": "heat",
